digraph AuditWorkflow {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.45, pad=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FBE9EA", color="#D31018", width=1.35, height=0.7];
  edge  [fontname="Helvetica", fontsize=8.5, color="#4A4A49"];

  up    [label="1. Upload\nregulation"];
  ai    [label="2. AI analysis\nclauses → requirements", fillcolor="#FFF6E5", color="#B7791F"];
  plan  [label="3. Audit structure\n& question set", fillcolor="#FFF6E5", color="#B7791F"];
  rev   [label="4. Auditor review\n& approval"];
  exec  [label="5. Audit execution\nautomatic + manual"];
  find  [label="6. Findings\n(nonconformities)"];
  capa  [label="7. CAPA tasks\nowner · due date"];
  ver   [label="8. Verification\nof effectiveness"];
  close [label="Closed", shape=doublecircle, width=0.7, fillcolor="#EAF6EE", color="#2E8B57"];

  up -> ai -> plan -> rev -> exec -> find -> capa -> ver -> close;
  rev -> plan [label="edit / reject", style=dashed, constraint=false];
  ver -> capa [label="not effective", style=dashed, constraint=false];

  data [label="System data\nassignments · scores ·\naudit log", shape=cylinder, fillcolor="#EEF2F7", color="#4A4A49"];
  data -> exec [label="automatic checks", style=dashed];
}
