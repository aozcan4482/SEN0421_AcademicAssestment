# Copy this file to .env and fill in the values.
# .env is ignored by Git: never commit real passwords.

# HTTP server
# 0.0.0.0 lets mobile devices on the same network reach the API.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# PostgreSQL (see database/README.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academic_assessment
DB_USER=aams_app
DB_PASSWORD=
DB_POOL_MAX=10

# Authentication
# Long random secret used to sign session tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Failed login attempts allowed per IP address in 15 minutes
LOGIN_RATE_LIMIT=10
# Set to true only when running behind a TLS-terminating reverse proxy
TRUST_PROXY=false

# CATS single sign-on
#   live: verify jury/student credentials against the CATS portal
#   mock: development only - any registered jury/student signs in with
#         CATS_MOCK_PASSWORD (refused when NODE_ENV=production)
CATS_MODE=live
CATS_LOGIN_URL=https://cats.iku.edu.tr/portal/xlogin
CATS_TIMEOUT_MS=10000
CATS_MOCK_PASSWORD=
