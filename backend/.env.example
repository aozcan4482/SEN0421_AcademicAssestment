# Copy this file to .env and fill in the values.
# .env is ignored by Git: never commit real passwords.

# HTTP server
# 0.0.0.0 lets mobile devices on the same network reach the API.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# PostgreSQL (see database/README.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academic_assessment
DB_USER=aams_app
DB_PASSWORD=
DB_POOL_MAX=10
