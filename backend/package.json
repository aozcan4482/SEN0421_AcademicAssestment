{
  "name": "academic-assessment-api",
  "version": "0.1.0",
  "description": "REST API of the Academic Assessment & Audit Management System",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "set-admin-password": "node scripts/set-admin-password.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "nodemon": "3.1.11",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ],
        "testEnvironment": "node"
      }
    ]
  }
}
